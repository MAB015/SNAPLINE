# ---------------------------------------------------------------------------
# SNAPLINE — variables de entorno
# Copia este archivo a .env.local (web/) y .env (contracts/) y rellena.
# Ningún valor real vive en el repositorio.
# ---------------------------------------------------------------------------

# --- contracts/ ---------------------------------------------------------
# Llave privada de la cuenta de despliegue. SOLO testnet. Nunca una cuenta
# con fondos reales.
DEPLOYER_PRIVATE_KEY=
# RPC de HSKChain Testnet. Cualquier proveedor sirve; el público aguanta el demo.
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
# Para verificar el código fuente en el explorador.
HSK_TESTNET_VERIFIER_URL=https://testnet-explorer.hskchain.net/api/

# --- web/ ---------------------------------------------------------------
# Privy: identidad y wallet embebida. Crea la app en dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Supabase: relay de firmas. Solo transporta firmas, no custodia fondos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direcciones desplegadas (ver deployments/hashkey-testnet.json)
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=133
